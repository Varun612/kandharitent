# ==============================================================================
# Kandhari Tent & Caterers � Environment Variables Configuration (.env.example)
# Brand: Kandhari Tent & Caterers | Dwarka Shri Lawn, Lucknow
# ==============================================================================

# 1. Server Runtime Configuration
NODE_ENV=production
PORT=5000

# 2. Database Connection (MongoDB Atlas or self-hosted)
# Provide your production MongoDB connection string.
# If omitted, the server operates on its resilient local JSON seed data.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/kandhari_tent?retryWrites=true&w=majority

# 3. Security & Authentication
# Strong random 32+ character secret for signing customer and admin JWT tokens
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters

# 4. Master Admin Credentials
# Used for the administrative management dashboard at /admin/login
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAIL=contact@kandharitent.com

# 5. Generative AI Advisory (Google Gemini API)
# Optional: Enables Google Gemini 2.5 Flash for natural multi-turn event advice.
# If left empty, the server automatically uses the built-in bilingual rule-based NLP engine.
GEMINI_API_KEY=your_google_gemini_api_key_here

# 6. Official Business Contact Numbers (Lucknow Desk)
BUSINESS_PHONE=1800-890-3456
WHATSAPP_PHONE=9118008903456

# 7. Allowed CORS Origins (Optional, default allows all or deployment origin)
CORS_ORIGIN=*


# Toll-Free Business Hotline & WhatsApp Support
BUSINESS_TOLL_FREE_NUMBER=1800-890-3456
PUBLIC_WHATSAPP_PHONE=9118008903456
# Private Owner Forwarding (Internal notification only — NEVER exposed to clients or public APIs)
BUSINESS_OWNER_FORWARD_PHONE=919876543210
