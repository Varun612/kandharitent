{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/items/(.*)",
      "destination": "/api"
    },
    {
      "source": "/items",
      "destination": "/api"
    },
    {
      "source": "/venue/(.*)",
      "destination": "/api"
    },
    {
      "source": "/venue",
      "destination": "/api"
    },
    {
      "source": "/enquiries/(.*)",
      "destination": "/api"
    },
    {
      "source": "/enquiries",
      "destination": "/api"
    },
    {
      "source": "/gallery/(.*)",
      "destination": "/api"
    },
    {
      "source": "/gallery",
      "destination": "/api"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/auth",
      "destination": "/api"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/api"
    },
    {
      "source": "/chat",
      "destination": "/api"
    },
    {
      "source": "/catering/(.*)",
      "destination": "/api"
    },
    {
      "source": "/catering",
      "destination": "/api"
    },
    {
      "source": "/payments/(.*)",
      "destination": "/api"
    },
    {
      "source": "/payments",
      "destination": "/api"
    },
    {
      "source": "/notifications/(.*)",
      "destination": "/api"
    },
    {
      "source": "/notifications",
      "destination": "/api"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/api"
    },
    {
      "source": "/reports",
      "destination": "/api"
    },
    {
      "source": "/inventory/(.*)",
      "destination": "/api"
    },
    {
      "source": "/inventory",
      "destination": "/api"
    },
    {
      "source": "/staff/(.*)",
      "destination": "/api"
    },
    {
      "source": "/staff",
      "destination": "/api"
    },
    {
      "source": "/analytics/(.*)",
      "destination": "/api"
    },
    {
      "source": "/analytics",
      "destination": "/api"
    },
    {
      "source": "/agent/(.*)",
      "destination": "/api"
    },
    {
      "source": "/agent",
      "destination": "/api"
    },
    {
      "source": "/agents/(.*)",
      "destination": "/api"
    },
    {
      "source": "/agents",
      "destination": "/api"
    },
    {
      "source": "/receptionist/(.*)",
      "destination": "/api"
    },
    {
      "source": "/receptionist",
      "destination": "/api"
    },
    {
      "source": "/invoices/(.*)",
      "destination": "/api"
    },
    {
      "source": "/invoices",
      "destination": "/api"
    },
    {
      "source": "/marketing/(.*)",
      "destination": "/api"
    },
    {
      "source": "/marketing",
      "destination": "/api"
    },
    {
      "source": "/settings/(.*)",
      "destination": "/api"
    },
    {
      "source": "/settings",
      "destination": "/api"
    },
    {
      "source": "/coupons/(.*)",
      "destination": "/api"
    },
    {
      "source": "/coupons",
      "destination": "/api"
    },
    {
      "source": "/((?!api|items|venue|enquiries|gallery|auth|chat|catering|payments|notifications|reports|inventory|staff|analytics|agent|agents|receptionist|invoices|marketing|settings|coupons|health).*)",
      "destination": "/index.html"
    }
  ]
}
