{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/items/(.*)",
      "destination": "/api"
    },
    {
      "source": "/items",
      "destination": "/api"
    },
    {
      "source": "/venue/(.*)",
      "destination": "/api"
    },
    {
      "source": "/venue",
      "destination": "/api"
    },
    {
      "source": "/enquiries/(.*)",
      "destination": "/api"
    },
    {
      "source": "/enquiries",
      "destination": "/api"
    },
    {
      "source": "/gallery/(.*)",
      "destination": "/api"
    },
    {
      "source": "/gallery",
      "destination": "/api"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/auth",
      "destination": "/api"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/api"
    },
    {
      "source": "/chat",
      "destination": "/api"
    },
    {
      "source": "/catering/(.*)",
      "destination": "/api"
    },
    {
      "source": "/catering",
      "destination": "/api"
    },
    {
      "source": "/payments/(.*)",
      "destination": "/api"
    },
    {
      "source": "/payments",
      "destination": "/api"
    },
    {
      "source": "/notifications/(.*)",
      "destination": "/api"
    },
    {
      "source": "/notifications",
      "destination": "/api"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/api"
    },
    {
      "source": "/reports",
      "destination": "/api"
    },
    {
      "source": "/((?!api|items|venue|enquiries|gallery|auth|chat|catering|payments|notifications|reports|health).*)",
      "destination": "/index.html"
    }
  ]
}
