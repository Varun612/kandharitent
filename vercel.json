{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/catering/menu",
      "destination": "/api"
    },
    {
      "source": "/catering/packages",
      "destination": "/api"
    },
    {
      "source": "/catering/enquiries",
      "destination": "/api"
    },
    {
      "source": "/items/(.*)",
      "destination": "/api"
    },
    {
      "source": "/items",
      "destination": "/api"
    },
    {
      "source": "/enquiries/(.*)",
      "destination": "/api"
    },
    {
      "source": "/enquiries",
      "destination": "/api"
    },
    {
      "source": "/delivery-partners/(.*)",
      "destination": "/api"
    },
    {
      "source": "/delivery-partners",
      "destination": "/api"
    },
    {
      "source": "/agents/(.*)",
      "destination": "/api"
    },
    {
      "source": "/settings/(.*)",
      "destination": "/api"
    },
    {
      "source": "/settings",
      "destination": "/api"
    },
    {
      "source": "/((?!api|items|enquiries|health|catering/menu|catering/packages|catering/enquiries|delivery-partners|agents|settings|media).*)",
      "destination": "/index.html"
    }
  ]
}
