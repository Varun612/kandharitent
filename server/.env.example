# Server Environment Configuration
# Kandhari Tent & Caterers & Dwarka Shri Lawn, Lucknow

# 1. Port & Server Runtime
PORT=5000
NODE_ENV=production

# 2. Database (MongoDB Connection String)
# If left blank or unavailable, automatically activates resilient LocalStore (server/data/localStore.json)
MONGODB_URI=mongodb://localhost:27017/kandhari_tent

# 3. Authentication & Security
# Change to a strong random 32+ character string in production
JWT_SECRET=kandhari_royal_secret_key_lucknow_2026_production

# 4. Initial Admin Account Bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@kandhari2026
ADMIN_EMAIL=contact@kandharitent.com

# 5. AI Service Adapter (Google Gemini API)
# Optional: If configured, enables Google Gemini 2.5 Flash for conversational intelligence.
# If omitted, system seamlessly runs on the built-in natural conversational NLP engine in English/Hindi.
GEMINI_API_KEY=your_gemini_api_key_here

# 6. CORS & Allowed Origins
# Specify comma-separated origins for production (e.g. https://kandhari-tent.vercel.app)
CORS_ORIGIN=*

# 7. Business & WhatsApp Numbers (Lucknow)
BUSINESS_PHONE=9305465848
WHATSAPP_PHONE=919305465848
